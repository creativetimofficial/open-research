{
  "name": "open-research",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source research agent: web search with citations, page reading, approvals and an audit log. Runs on Hermes or a lite in-process loop, on any OpenAI-compatible model endpoint.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@agent-starters/kit": "workspace:*",
    "@agent-starters/ui": "workspace:*",
    "linkedom": "0.18.13",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/creativetimofficial/open-research"
  },
  "packageManager": "pnpm@10.34.7"
}
